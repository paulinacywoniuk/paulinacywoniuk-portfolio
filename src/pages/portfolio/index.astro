---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyRow from '../../components/project/CaseStudyRow.astro';

/* ============================================================
   YOUR PROJECTS — one object per project, shown top to bottom
   in this order. Rows alternate: image left, then right, ...

   image    the big picture (light JPGs in /portfolio/listing/)
   logo     shown as a small sticker on the image corner
   accent   the project's color, as a CSS variable, so it follows
            your palette in global.css
   note     optional hand-written note under the image
   ============================================================ */
const projects = [
  {
    href: '/portfolio/echoes-design',
    image: '/portfolio/listing/echoes.jpg',
    imageAlt: 'A player in a VR headset in front of a projected clay bedroom from Echoes of Abandonment',
    logo: '/portfolio/echoes/echoes-logo.svg',
    // category: 'VR + UX research · Solo',
    title: 'Echoes of Abandonment',
    summary: "A VR experience about a child coping with their parents' divorce, in a bedroom sculpted by hand in clay. Later the testbed for my Master's research on interaction markers in VR.",
    tags: ['VR', 'Interactive Storytelling', 'UX research'],
    accent: 'var(--color-purple)',
    note: 'read about my UX research!',
  },
  {
    href: '/portfolio/irdeto',
    image: '/portfolio/listing/irdeto.jpg',
    imageAlt: 'Flat lay of Irdeto branding: tote bag, brochure, phone with social posts and business cards',
    logo: '/portfolio/irdeto/irdeto-logo.png',
    // category: 'Visual design · Internship',
    title: 'Irdeto Visual Design',
    summary: 'Visual design for a cybersecurity company and its sub-brands: social media carousels, infographics, login backgrounds, icons and web banners.',
    tags: ['Branding', 'Social Media', 'Icons'],
    accent: 'var(--color-blue)',
  },
  {
    href: '/portfolio/roots',
    image: '/portfolio/listing/roots.jpg',
    imageAlt: 'ROOTS Film Festival banner on the Filmhuis building',
    logo: '/portfolio/roots/roots-logo.png',
    // category: 'Visual identity · Team',
    title: 'Roots Film Festival',
    summary: 'A visual identity for a film festival in The Hague by Filmhuis Den Haag, designed with a team of students. I made the digital side: the festival website and email banners.',
    tags: ['Visual Identity', 'Digital Design', 'Physical Media'],
    accent: 'var(--color-orange)',
  },
  {
    href: '/portfolio/craftiplays',
    image: '/portfolio/listing/lands-of-magic.jpg',
    imageAlt: 'Phone showing Lands of Magic surrounded by illustrated game assets',
    logo: '/portfolio/craftiplays/craftiplays-logo.png',
    // category: 'Game assets + UI · Team',
    title: 'Lands of Magic',
    summary: 'Illustrated assets and UI for a mobile game, matched to an existing asset pack, including in-game buildings in normal, summer and Halloween skins.',
    tags: ['Illustration', 'Game UI', 'Game Assets Design'],
    accent: 'var(--color-cyan)',
    
  },
  {
    href: '/portfolio/nl12-vr',
    image: '/portfolio/listing/nl12.jpg',
    imageAlt: 'Working on a 3D model at a desk with VR controllers',
    logo: '/portfolio/nl12/nl12-logo.jpg',
    logoCover: true,
    // category: 'VR production · Internship',
    title: 'NL12 VR Production',
    summary: 'UV mapping, texture painting and Unity scene work for The March, a VR experience about the human stories behind war.',
    tags: ['VR', 'Technical Art', 'Digital Environment Design'],
    accent: 'var(--color-lime)',
  },
];
---

<BaseLayout
  title="Portfolio — Paulina Cywoniuk"
  description="Selected design and research projects by Paulina Cywoniuk."
>
  <section class="portfolio">
    <header class="portfolio-header">
      <h1 class="portfolio-heading">Portfolio</h1>
      <p class="portfolio-intro">A selection of my work across design and research.</p>
    </header>

    <div class="portfolio-rows">
      {projects.map((project, i) => (
        <CaseStudyRow
          {...project}
          number={String(i + 1).padStart(2, '0')}
          reverse={i % 2 === 1}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .portfolio {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 4rem) var(--space-page) clamp(4rem, 10vw, 8rem);
  }

  .portfolio-header {
    margin-bottom: clamp(3rem, 8vw, 6rem);
  }

  .portfolio-heading {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    color: var(--color-purple);
    margin-bottom: 0.5rem;
  }

  .portfolio-intro {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--color-text-muted);
    max-width: 50ch;
  }

  .portfolio-rows {
    display: flex;
    flex-direction: column;
    gap: clamp(5rem, 12vw, 9rem);          /* KNOB: space between projects */
  }
</style>
