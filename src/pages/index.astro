---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Paulina Cywoniuk — Designer & VR Researcher"
  description="Portfolio of Paulina Cywoniuk: designer, VR researcher, and game technology master's student."
>
  <section class="hero">

    <!-- Vertical squiggle that weaves behind everything -->
    <svg class="squiggle" viewBox="0 0 200 1000" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path
        d="M 100 0
           C 40 100, 160 200, 100 300
           S 40 500, 100 600
           S 160 800, 100 1000"
        stroke="var(--color-purple)"
        stroke-width="80"
        stroke-linecap="round"
        fill="none"
        class="squiggle-path"
      />
    </svg>

    <!-- The PORTFOLIO + signature composition -->
    <div class="hero-stack">

      <!-- PORTFOLIO wordmark -->
      <img
        src={`/assets/portfolio-wordmark.svg`.replace('//', '/')}
        alt="Portfolio"
        class="wordmark"
      />

      <!-- "by Paulina Cywoniuk" — overlaps onto the bottom of PORTFOLIO -->
      <div class="signature">
        <span class="signature-by">by</span>
        <img
          src={`/assets/paulina-name.svg`.replace('//', '/')}
          alt="Paulina Cywoniuk"
          class="signature-name"
        />
      </div>

    </div>

    <!-- Scroll indicator -->
    <!-- NOTE: previously pointed to #below (the deleted physics section).
         Re-point this href at your new section's id once you build it. -->
    <a href="#" class="scroll-indicator" aria-label="Scroll down">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M12 5 L12 19 M5 12 L12 19 L19 12"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </a>
  </section>

</BaseLayout>

<style>
  /* ============================================================
     HERO LAYOUT
     ============================================================ */
  .hero {
    position: relative;
    min-height: calc(100vh - 100px); /* viewport minus navbar */
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem var(--space-page) 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* ============================================================
     SQUIGGLE — vertical wave weaving behind everything
     ============================================================ */
  .squiggle {
    position: absolute;
    /* Position: centered horizontally, spans full height */
    top: 0;
    bottom: 0;
    left: 65%;
    transform: translateX(-50%);
    height: 100%;
    width: clamp(200px, 30vw, 400px); /* width of the squiggle's wave area */
    z-index: 0; /* behind the text */
    pointer-events: none;
  }

  /* The SVG draw-in animation works by setting the path's
     stroke-dasharray to its total length, then animating
     stroke-dashoffset from that length down to 0. */
  .squiggle-path {
    stroke-dasharray: 3000;
    stroke-dashoffset: 3000;
    animation: draw-squiggle 2s ease-in-out 0.2s forwards;
  }

  /* ============================================================
     COMPOSITION STACK (wordmark + signature overlap)
     ============================================================ */
  .hero-stack {
    position: relative;
    z-index: 1; /* above the squiggle */
    width: 100%;
    max-width: 1000px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* PORTFOLIO wordmark */
  .wordmark {
    width: 100%;
    height: auto;
    display: block;
    animation: wordmark-in 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) 0.6s both;
  }

  /* Signature: overlaps onto the bottom of PORTFOLIO with negative margin */
  .signature {
    /* This is the "crash" — pulls the signature up into the wordmark */
    margin-top: clamp(-3rem, -6vw, -5rem);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    /* Slight rotation for the playful overlap feeling */
    transform: rotate(-2deg);
    animation: signature-in 0.7s ease-out 1.3s both;
  }

  .signature-by {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    color: var(--color-blue);
    /* Cursive-ish feel from Fraunces italic */
  }

  .signature-name {
    /* Aim for ~1/3 the height of the wordmark.
       Wordmark renders at viewport-relative size; we use clamp here too. */
    height: clamp(2.5rem, 7vw, 30rem);
    width: auto;
    display: block;
  }

  /* ============================================================
     SCROLL INDICATOR
     ============================================================ */
  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    width: 32px;
    height: 32px;
    color: var(--color-purple);
    opacity: 0;
    animation:
      scroll-fade 0.5s ease-out 2s forwards,
      scroll-bounce 2s ease-in-out 2.5s infinite;
    z-index: 2;
  }

  .scroll-indicator svg {
    width: 100%;
    height: 100%;
  }

  .scroll-indicator:hover {
    color: var(--color-blue);
  }

  /* ============================================================
     ANIMATIONS
     ============================================================ */
  @keyframes draw-squiggle {
    to { stroke-dashoffset: 0; }
  }

  @keyframes wordmark-in {
    0% {
      opacity: 0;
      transform: scale(0.9);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes signature-in {
    0% {
      opacity: 0;
      transform: rotate(-2deg) translateY(20px);
    }
    100% {
      opacity: 1;
      transform: rotate(-2deg) translateY(0);
    }
  }

  @keyframes scroll-fade {
    to { opacity: 0.7; }
  }

  @keyframes scroll-bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  /* Respect users who don't want animations */
  @media (prefers-reduced-motion: reduce) {
    .squiggle-path,
    .wordmark,
    .signature,
    .scroll-indicator {
      animation: none;
      opacity: 1;
      stroke-dashoffset: 0;
    }
  }

  /* ============================================================
     MOBILE TWEAKS
     ============================================================ */
  @media (max-width: 640px) {
    .squiggle {
      width: 60vw; /* squiggle takes more relative width on mobile */
    }

    .signature {
      margin-top: clamp(-2rem, -5vw, -3rem);
    }
  }
</style>