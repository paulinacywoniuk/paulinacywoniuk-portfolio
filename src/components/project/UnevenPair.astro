---
/* ============================================================
   UnevenPair.astro — two images side by side, deliberately NOT
   equal: the first is wider, the second narrower and set lower.
   Each has an optional caption.

   <UnevenPair
     aSrc="/portfolio/roots/roots-3.jpg" aAlt="..." aCaption="Tote bags"
     bAlt="Logo sketches"                bCaption="..."
   />
   (no bSrc yet → dashed placeholder)

   IMAGE SHAPE — both images are cut to 4:3 by default. If an
   image gets cropped too much, give it its own shape:
     bRatio="auto"     → shows the WHOLE image, in its own shape
     bRatio="16 / 9"   → any other shape you like
   (same for aRatio)
   ============================================================ */
const {
  aSrc, aAlt = '', aCaption,
  bSrc, bAlt = '', bCaption,
  offset = '0rem',              // KNOB: how much lower the second image sits (try '5rem')
  aRatio = '4 / 3',             // KNOB: shape of image A ('auto' = its own shape)
  bRatio = '4 / 3',             // KNOB: shape of image B ('auto' = its own shape)
} = Astro.props;
---

<section class="pair" style={`--offset: ${offset}; --a-ratio: ${aRatio}; --b-ratio: ${bRatio};`}>
  <figure class="pair-a">
    {aSrc ? (
      <img src={aSrc} alt={aAlt} class="pair-img" />
    ) : (
      <div class="pair-img placeholder">[{aAlt}]</div>
    )}
    {aCaption && <figcaption>{aCaption}</figcaption>}
  </figure>

  <figure class="pair-b">
    {bSrc ? (
      <img src={bSrc} alt={bAlt} class="pair-img" />
    ) : (
      <div class="pair-img placeholder">[{bAlt}]</div>
    )}
    {bCaption && <figcaption>{bCaption}</figcaption>}
  </figure>
</section>

<style>
  .pair {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .pair figure {
    margin: 0;
    min-width: 0;
  }

  .pair-a {
    flex: 1.5 1 26rem;               /* KNOB: first number = how much wider A is */
  }

  /* ".pair .pair-b" (not just ".pair-b") so this beats the
     "margin: 0" of ".pair figure" above */
  .pair .pair-b {
    flex: 1 1 18rem;
    margin-top: var(--offset);
  }

  .pair-img {
    width: 100%;
    height: auto;
    object-fit: cover;               /* fills the shape, crops the edges */
    display: block;
    border-radius: 16px;
  }

  .pair-a .pair-img { aspect-ratio: var(--a-ratio); }
  .pair-b .pair-img { aspect-ratio: var(--b-ratio); }

  .pair figcaption {
    margin-top: 0.75rem;
    font-size: 1rem;
    color: var(--color-text-muted);
  }

  .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    box-sizing: border-box;
    border: 2px dashed var(--color-purple);
    color: var(--color-purple);
    text-align: center;
    min-height: 12rem;               /* so an 'auto' placeholder doesn't collapse */
  }

  /* On phones the two stack, so the offset isn't needed */
  @media (max-width: 640px) {
    .pair .pair-b {
      margin-top: 0;
    }
  }
</style>