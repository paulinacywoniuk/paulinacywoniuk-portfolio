---
const base = import.meta.env.BASE_URL;

const navLinks = [
  { label: 'About', href: '/about' },
  { label: 'Portfolio', href: `/portfolio`.replace('//', '/') },
  { label: 'Research', href: `/research`.replace('//', '/'), isResearch: true },
  { label: 'Contact', href: `/contact`.replace('//', '/') },
];
---

<nav class="nav">
  <a href={base} class="nav-logo">Paulina Cywoniuk</a>
  <ul class="nav-links">
    {navLinks.map((link) => (
      <li>
        <a href={link.href} class={link.isResearch ? 'nav-link-research' : ''}>
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem var(--space-page);
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .nav-logo {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--color-purple);
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
  }

  .nav-links a {
    color: var(--color-text);
    font-weight: 500;
    font-size: 0.95rem;
    position: relative;
  }

  .nav-links a:hover {
    color: var(--color-purple);
  }

  /* Research link gets visual distinction —
     a small lime dot before the label, since the user
     asked us to keep the name "Research" but differentiate it */
  .nav-link-research {
    padding-left: 1rem;
  }

  .nav-link-research::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 8px;
    height: 8px;
    background-color: var(--color-lime);
    border-radius: 50%;
  }

  @media (max-width: 640px) {
    .nav {
      flex-direction: column;
      gap: 1rem;
    }
    .nav-links {
      gap: 1.25rem;
    }
  }
</style>