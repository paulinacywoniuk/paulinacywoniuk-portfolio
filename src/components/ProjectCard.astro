---
/* ============================================================
   ProjectCard.astro

   One project in the portfolio listing: a title + an image,
   the WHOLE thing a single clickable link.

   The card does NOT decide how wide it is. It fills whatever
   space the page gives it. Spacing between cards in the grid
   lives on the page, not here.

   SIZE — three versions of the same card:
     size="featured"  big title above image (Echoes, top of page)
     size="small"     smaller title above image (2-column grid)
     size="row"       image on the LEFT, title on the RIGHT,
                      spanning the full width (list view)

   TITLE IS FLEXIBLE: pass EITHER titleText OR titleSvg.
   ============================================================ */

const {
  href,
  image,
  imageAlt = '',

  // --- Size: 'featured', 'small' or 'row' (see above) ---
  size = 'featured',

  // --- Title: pass EITHER titleText OR titleSvg ---
  titleText,
  titleSvg,
  titleSvgAlt = '',

  // --- Optional per-project styling knobs ---
  titleFont = 'var(--font-display)',
  titleColor = 'var(--color-text)',
} = Astro.props;
---

<!-- class:list adds e.g. "project-card--small" based on the size prop -->
<a href={href} class:list={['project-card', `project-card--${size}`]}>

  {titleSvg ? (
    <img src={titleSvg} alt={titleSvgAlt} class="project-title-svg" />
  ) : (
    <h2
      class="project-title-text"
      style={`font-family: ${titleFont}; color: ${titleColor};`}
    >
      {titleText}
    </h2>
  )}

  <div class="project-image-wrap">
    <img src={image} alt={imageAlt} class="project-image" />
  </div>

</a>

<style>
  /* ============================================================
     THE CARD (featured + small): title stacked above image
     ============================================================ */
  .project-card {
    display: flex;
    flex-direction: column;
    align-items: center;          /* centers title + image horizontally */

    /* Pushes title + image to the BOTTOM of the card, so images in
       the same grid row line up even if one title wraps.
       KNOB: flex-start to align TITLES instead of images. */
    justify-content: flex-end;

    text-decoration: none;
    color: inherit;
  }

  .project-card:hover {
    color: inherit;
  }

  /* ============================================================
     TITLE — featured size by default...
     ============================================================ */
  .project-title-text {
    font-size: clamp(2rem, 6vw, 4rem);      /* KNOB: featured title size */
    line-height: 1.05;
    margin-bottom: clamp(1rem, 2.5vw, 1.75rem);
    text-align: center;
  }

  .project-title-svg {
    height: clamp(2.5rem, 7vw, 5rem);       /* KNOB: featured SVG title height */
    width: auto;
    margin-bottom: clamp(1rem, 2.5vw, 1.75rem);
  }

  /* ...and smaller for grid cells */
  .project-card--small .project-title-text {
    font-size: clamp(1.5rem, 3vw, 2rem);    /* KNOB: small title size */
    margin-bottom: clamp(0.75rem, 1.5vw, 1rem);
  }

  .project-card--small .project-title-svg {
    height: clamp(1.75rem, 3.5vw, 2.5rem);  /* KNOB: small SVG title height */
    margin-bottom: clamp(0.75rem, 1.5vw, 1rem);
  }

  /* ============================================================
     ROW VERSION (list view): image LEFT, title RIGHT

     This switches the card from flexbox to CSS grid with two
     columns. grid-template-areas is a little "map" of the row:
     "image title" means image box on the left, title on the
     right. The order in the HTML doesn't matter: each element
     is told which area to sit in with grid-area.
     ============================================================ */
  .project-card--row {
    display: grid;
    grid-template-columns: 40% 1fr;         /* KNOB: thumbnail width (try 30%, 50%) */
    grid-template-areas: "image title";
    align-items: center;                    /* title vertically centered next to image */
    column-gap: clamp(1.5rem, 4vw, 3rem);   /* KNOB: space between image and title */

    /* Each row is a "cell": padding inside + a thin line on top */
    padding-block: clamp(1.5rem, 3vw, 2.5rem);  /* KNOB: row height breathing room */
    border-top: 1px solid rgba(0, 0, 0, 0.12);  /* KNOB: divider line (delete to remove) */
  }

  /* Close off the list with a line under the last row too */
  .project-card--row:last-child {
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
  }

  .project-card--row .project-image-wrap {
    grid-area: image;
  }

  .project-card--row .project-title-text,
  .project-card--row .project-title-svg {
    grid-area: title;
    margin-bottom: 0;
    text-align: left;                       /* KNOB: aligned left */
  }

  .project-card--row .project-title-text {
    font-size: clamp(1.5rem, 3.5vw, 2.75rem);   /* KNOB: row title size */
  }

  /* On phones a side-by-side row is too cramped: stack it,
     title on top (same as the other cards). */
  @media (max-width: 640px) {
    .project-card--row {
      grid-template-columns: 1fr;
      grid-template-areas:
        "title"
        "image";
      row-gap: 0.75rem;
    }
  }

  /* ============================================================
     IMAGE — fills its box, landscape ratio
     ============================================================ */
  .project-image-wrap {
    width: 100%;
    aspect-ratio: 953 / 535;               /* same shape for every card */

    border-radius: 16px;                   /* KNOB: roundness */
    overflow: hidden;
    box-shadow:
      0 4px 16px rgba(0, 0, 0, 0.08),
      0 1px 4px rgba(0, 0, 0, 0.05);
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  /* ============================================================
     HOVER — gentle zoom, only on hover-capable devices
     ============================================================ */
  @media (hover: hover) {
    .project-card:hover .project-image {
      transform: scale(1.03);              /* KNOB: zoom amount */
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-image {
      transition: none;
    }
    .project-card:hover .project-image {
      transform: none;
    }
  }
</style>