---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

/* ============================================================
   THE FIVE PROJECTS — this is your content, as data.

   To add or edit a project later, you edit THIS array. You do
   not touch layout code. Each project is an object with the
   props ProjectCard understands.

   Pass EITHER titleText (for live-font titles) OR titleSvg
   (for outlined-font titles like Echoes). See ProjectCard.astro
   for the full list of options.

   NOTE ON IMAGES: the paths below point at files in your
   `public/` folder. Put the images there (e.g.
   public/portfolio/roots-cover.jpg) and the paths will work.
   Images that don't exist yet will show as broken — that's
   expected until you add them. I've left placeholders so you
   can see the layout and swap in real files as you make them.
   ============================================================ */

const projects = [
  {
    href: '/portfolio/roots',
    image: '/portfolio/roots-cover.png',
    imageAlt: 'ROOTS Film Festival visual identity — festival banners on a building',
    titleText: 'Roots Film Festival',
    // Roots title font is still TBD (open-source display face).
    // For now it uses your display font. We'll set titleFont here
    // once you pick one, e.g. titleFont: "'Fraunces', serif".
  },
    {
    href: '/portfolio/echoes-design',
    image: '/portfolio/echoes-cover.png',
    imageAlt: 'Echoes of Abandonment — VR experience with a hand-sculpted clay bedroom',
    titleText: 'Echoes of Abandonment',
  },
  {
    href: '/portfolio/nl12-vr',
    image: '/portfolio/nl12-cover.png',
    imageAlt: 'NL12 internship — VR production work',
    titleText: 'NL12 — VR Production',
  },
  {
    href: '/portfolio/craftiplays',
    image: '/portfolio/craftiplays-cover.jpg',
    imageAlt: 'Lands of Magic — mobile game asset illustrations',
    titleText: 'Lands of Magic — Game Assets',
  },
  {
    href: '/portfolio/irdeto',
    image: '/portfolio/irdeto-cover.png',
    imageAlt: 'Irdeto — visual design work',
    titleText: 'Visual Design — Irdeto',
    // Irdeto uses Montserrat (open-source, safe). We'll wire the
    // font import + set titleFont when we build this card:
    // titleFont: "'Montserrat', sans-serif",
  },
];
---

<BaseLayout
  title="Portfolio — Paulina Cywoniuk"
  description="Selected design and research projects by Paulina Cywoniuk."
>
  <section class="portfolio">

    <header class="portfolio-header">
      <h1 class="portfolio-heading">Portfolio</h1>
      <p class="portfolio-intro">
        A selection of my work across design and research.
      </p>
    </header>

    <div class="project-list">
      {projects.map((project) => (
        <ProjectCard {...project} />
      ))}
    </div>

  </section>
</BaseLayout>

<style>
  .portfolio {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 4rem) var(--space-page);
  }

  .portfolio-header {
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .portfolio-heading {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    color: var(--color-purple);
    margin-bottom: 0.5rem;
  }

  .portfolio-intro {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--color-text-muted);
    max-width: 50ch;
  }

  /* The list itself is just the cards stacked. Each card handles
     its own bottom spacing (margin-bottom in ProjectCard), so
     this container stays simple. */
  .project-list {
    display: block;
  }
</style>