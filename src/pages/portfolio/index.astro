---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Note the path: ../../ because we're now two folders deep

const base = import.meta.env.BASE_URL;

const categories = [
  {
    title: 'VR & AR',
    href: `${base}/portfolio/vr-ar`.replace('//', '/'),
    description: 'Immersive experiences and spatial interfaces.',
    color: 'var(--color-purple)',
    bgColor: 'var(--color-cyan)',
  },
  {
    title: 'Graphic Design',
    href: `${base}/portfolio/graphic-design`.replace('//', '/'),
    description: 'Visual identity, illustration, and printed matter.',
    color: 'var(--color-text)',
    bgColor: 'var(--color-orange)',
  },
  {
    title: 'UI/UX Research',
    href: `${base}/portfolio/ui-ux-research`.replace('//', '/'),
    description: 'User research, interaction studies, and prototyping.',
    color: 'white',
    bgColor: 'var(--color-blue)',
  },
];
---

<BaseLayout
  title="Portfolio — Paulina Cywoniuk"
  description="Selected projects across VR/AR, graphic design, and UI/UX research."
>
  <section class="portfolio-intro">
    <h1>Portfolio</h1>
    <p>Three threads of practice — choose where to start.</p>
  </section>

  <section class="categories">
    {categories.map((cat) => (
      <a href={cat.href} class="category-card" style={`background-color: ${cat.bgColor}; color: ${cat.color};`}>
        <h2>{cat.title}</h2>
        <p>{cat.description}</p>
        <span class="category-arrow">→</span>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .portfolio-intro {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: clamp(3rem, 8vh, 5rem) var(--space-page) 2rem;
  }

  .portfolio-intro h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    color: var(--color-purple);
    margin-bottom: 1rem;
  }

  .portfolio-intro p {
    font-size: 1.15rem;
    color: var(--color-text-muted);
  }

  .categories {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem var(--space-page);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .category-card {
    display: block;
    padding: 2.5rem 2rem;
    border-radius: 16px;
    text-decoration: none;
    transition: transform 0.2s ease;
    position: relative;
    min-height: 240px;
  }

  .category-card:hover {
    transform: translateY(-4px);
  }

  .category-card h2 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    color: inherit;
  }

  .category-card p {
    font-size: 1rem;
    line-height: 1.5;
    opacity: 0.85;
  }

  .category-arrow {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    font-size: 1.5rem;
    transition: transform 0.2s ease;
  }

  .category-card:hover .category-arrow {
    transform: translateX(6px);
  }
</style>